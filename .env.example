# ==============================================================================
# NusaProc — Nusanet Enterprise Procurement System
# Environment Variables Configuration Template (.env.example)
# ==============================================================================
# Copy this file to .env and adjust values for your environment:
# cp .env.example .env
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. SERVER & RUNTIME CONFIGURATION
# ------------------------------------------------------------------------------
# Backend HTTP Port (Default: 8000)
PORT=8000

# Environment Mode: development | test | production
NODE_ENV=development

# Allowed CORS Origins (Comma-separated for multiple, or * for development)
CORS_ORIGIN=*

# ------------------------------------------------------------------------------
# 2. DATABASE CONFIGURATION (PostgreSQL 16+)
# ------------------------------------------------------------------------------
# Connection string format: postgres://<user>:<password>@<host>:<port>/<dbname>
# For production over SSL, append: ?sslmode=require
DATABASE_URL=postgres://nusaproc_user:your_secure_password@localhost:5432/nusaproc_db

# ------------------------------------------------------------------------------
# 3. REDIS CACHE & BACKGROUND QUEUE (Redis 7.2+)
# ------------------------------------------------------------------------------
# Connection string format: redis://[<username>:<password>@]localhost:6379[/<db_index>]
REDIS_URL=redis://localhost:6379

# ------------------------------------------------------------------------------
# 4. SECURITY & AUTHENTICATION (JWT, Google SSO & Step-Up Re-Auth)
# ------------------------------------------------------------------------------
# Secret key used to sign and verify JWT authentication tokens (Minimum 32 characters)
JWT_SECRET=super-secret-jwt-signing-key-min-32-chars-change-in-production

# JWT Access Token Expiry (e.g. 24h, 7d, 3600s)
JWT_EXPIRY=24h

# Google Workspace OAuth 2.0 Client ID (from Google Cloud Console)
GOOGLE_CLIENT_ID=your-google-oauth-client-id.apps.googleusercontent.com

# Restricted Google Workspace Hosted Domain (Comma-separated: nusa.id, nusanet.net.id, nusa.net.id)
GOOGLE_ALLOWED_DOMAIN=nusa.id,nusanet.net.id,nusa.net.id

# ------------------------------------------------------------------------------
# 5. OBJECT & FILE STORAGE (WORM Legal Evidence & Invoices)
# ------------------------------------------------------------------------------
# Storage driver: local | s3 | minio (Default: local)
STORAGE_DRIVER=local

# Local storage path when STORAGE_DRIVER=local (Default: ./uploads)
STORAGE_LOCAL_PATH=./uploads

# S3 / MinIO configuration (Required when STORAGE_DRIVER=s3 or minio)
S3_ENDPOINT=http://localhost:9000
S3_BUCKET=nusaproc-evidence
S3_ACCESS_KEY=minioadmin
S3_SECRET_KEY=minioadmin
S3_REGION=us-east-1
S3_USE_SSL=false

# ------------------------------------------------------------------------------
# 6. ANTIVIRUS SCANNER (ClamAV Daemon)
# ------------------------------------------------------------------------------
# Host and port for ClamAV TCP daemon (Optional in dev, recommended in production)
CLAMAV_HOST=127.0.0.1
CLAMAV_PORT=3310

# ------------------------------------------------------------------------------
# 7. INTEGRATION & OUTBOX WEBHOOKS
# ------------------------------------------------------------------------------
# Maximum retry attempts before routing to Dead-Letter Queue (DLQ)
WEBHOOK_RETRY_LIMIT=5

# HTTP request timeout for outgoing webhooks in milliseconds
WEBHOOK_TIMEOUT_MS=10000

# ------------------------------------------------------------------------------
# 8. FRONTEND CLIENT CONFIGURATION (Vite SPA)
# ------------------------------------------------------------------------------
# Base URL for backend REST API in frontend (Default: /api/v1 for same-origin proxy)
# Set to full URL (e.g. https://api.nusaproc.nusanet.net.id/api/v1) if hosted on separate subdomains
VITE_API_BASE_URL=/api/v1

# Google Sign-In OAuth Client ID for frontend Google Identity Services
VITE_GOOGLE_CLIENT_ID=your-google-oauth-client-id.apps.googleusercontent.com

# Application Brand Name (Default: NusaProc)
VITE_APP_NAME=NusaProc

# Application Subtitle / Tagline on Login Page (Default: Sistem Pengadaan Terpadu PT Nusanet)
VITE_APP_SUBTITLE=Sistem Pengadaan Terpadu PT Nusanet

# Application Title displayed in browser tab
VITE_APP_TITLE=NusaProc — Nusanet Procurement System



